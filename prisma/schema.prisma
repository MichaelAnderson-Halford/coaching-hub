generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERADMIN
  CLIENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CLIENT)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  lastSeenAt             DateTime?

  nextMeetingAt DateTime?
  zoomLink      String?
  zoomPassword  String?
  zoomMeetingId String?
  reminderSentForMeetingAt DateTime?
  thirtyMinReminderSentAt  DateTime?
  ninetyDayPlan String?   @db.Text
  archivedAt    DateTime?
  clientMessage          String?   @db.Text
  clientMessageUpdatedAt DateTime?

  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  clientAccountId String?

  notesAsClient  Note[]     @relation("ClientNotes")
  notesAsAuthor  Note[]     @relation("AuthorNotes")
  sentMessages   Message[]  @relation("SentMessages")
  threadMessages Message[]  @relation("ClientThread")
  passwordResetTokens PasswordResetToken[]
}

// One of a client's businesses/ventures. Most clients have exactly one —
// the UI only shows a business switcher when a client has more than one.
// Metrics and the AI briefing are scoped per business, since progress on
// separate ventures shouldn't be blended together. The 90-day plan is
// shared at the client level (see User.ninetyDayPlan) since most coaches
// think of it as one overall plan for the relationship.
model Business {
  id               String    @id @default(cuid())
  name             String
  insight          String?   @db.Text
  insightUpdatedAt DateTime?
  createdAt        DateTime  @default(now())

  clientAccount   ClientAccount?  @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  clientAccountId String?
  clientId String?

  metrics       Metric[]
  homeworkItems HomeworkItem[]
  projects      Project[]
}

model Note {
  id        String   @id @default(cuid())
  content   String
  // Private notes never appear on the client's own dashboard — for the
  // coach's internal thinking only.
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())

  client   User   @relation("ClientNotes", fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  author   User   @relation("AuthorNotes", fields: [authorId], references: [id])
  authorId String
}

model Win {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  clientAccount   ClientAccount?  @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  clientAccountId String?
  clientId String?
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  url         String?
  description String?
  createdAt   DateTime @default(now())

  clientAccount   ClientAccount?  @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  clientAccountId String?
  clientId String?
}

// A structured record of an actual coaching call — separate from the
// freeform Notes feed, since a call summary reads much better broken
// into date/duration/summary than pasted as one flat block of text.
model Session {
  id              String   @id @default(cuid())
  sessionNumber   Int
  date            DateTime @default(now())
  durationMinutes Int?
  summary         String   @db.Text
  createdAt       DateTime @default(now())

  clientAccount   ClientAccount?  @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  clientAccountId String?
  clientId String?
}

// Small between-session commitments — either the coach or the client can
// add these, and either side can check them off. Optionally scoped to one
// of the client's businesses/projects, so the Homework tab can group by
// project; homeworkItems with no businessId show under "General".
model HomeworkItem {
  id          String    @id @default(cuid())
  title       String
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  clientAccount   ClientAccount?  @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  clientAccountId String?
  clientId String?

  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  businessId String?

  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  homeworkItems HomeworkItem[]
}

// Every message belongs to exactly one client's thread (shared across all
// of that client's businesses). The sender may be that client, or one of
// the coaches (Michael / Ben) replying into it.
model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  readByCoach Boolean  @default(false)

  sender   User   @relation("SentMessages", fields: [senderId], references: [id])
  senderId String

  client   User   @relation("ClientThread", fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
}

// A metric a specific business tracks over time, e.g. "Weight", "Weekly
// revenue". Each metric has many data points.
model Metric {
  id        String   @id @default(cuid())
  name      String
  unit      String?
  target    Float?
  createdAt DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  entries MetricEntry[]
}

model MetricEntry {
  id         String   @id @default(cuid())
  value      Float
  recordedAt DateTime @default(now())

  metric   Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  metricId String
}

// Lightweight abuse protection — records an event per attempt (failed
// login, intake submission) keyed by email or IP, so we can count recent
// attempts within a time window without needing an external service.
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// A structured quarterly success plan for a client — one document that
// contains a section per business, each with its own theme, personal
// recommendations, projects (outcome/approach/measures/timeline), and KPIs.
// Replaces the old plain-text ninetyDayPlan when present.
model Plan {
  id           String    @id @default(cuid())
  quarterLabel String
  startDate    DateTime?
  endDate      DateTime?
  advisorName  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clientAccount   ClientAccount?  @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  clientAccountId String? @unique
  clientId String? @unique

  sections PlanSection[]
}

model PlanSection {
  id               String  @id @default(cuid())
  businessName     String
  theme            String?
  themeDescription String? @db.Text
  // Recommendations stored as newline-separated "Title: description" lines
  // — simple to edit in a textarea, simple to render as a list.
  recommendations  String? @db.Text
  order            Int     @default(0)

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId String

  projects PlanProject[]
  kpis     PlanKpi[]
}

model PlanProject {
  id          String  @id @default(cuid())
  name        String
  outcome     String  @db.Text
  // Bullet lists stored as newline-separated text — one line per bullet.
  keyApproach String  @db.Text
  measures    String  @db.Text
  month1Label String?
  month2Label String?
  month3Label String?
  order       Int     @default(0)

  section   PlanSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String
}

model PlanKpi {
  id    String  @id @default(cuid())
  name  String
  value String?
  order Int     @default(0)

  section   PlanSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  customDomain String?  @unique
  plan               String    @default("trial")
  trialEndsAt        DateTime?
  stripeCustomerId   String?   @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus String?
  tier               String?
  createdAt    DateTime @default(now())

  users User[]
  clientAccounts ClientAccount[]
}

// The actual client/business relationship — shared by every owner who
// can log in to see it. Holds everything that isn't specific to one
// individual login (their own notes/messages stay on User).
model ClientAccount {
  id           String    @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nextMeetingAt DateTime?
  zoomLink      String?
  zoomPassword  String?
  zoomMeetingId String?
  archivedAt    DateTime?
  ninetyDayPlan String?   @db.Text
  reminderSentForMeetingAt DateTime?
  clientMessage          String?   @db.Text
  clientMessageUpdatedAt DateTime?
  createdAt DateTime @default(now())

  owners        User[]
  businesses    Business[]
  resources     Resource[]
  wins          Win[]
  sessions      Session[]
  plan          Plan?
  homeworkItems HomeworkItem[]
}
